FROM ./gpt2-model.gguf

# حدد الحد الأقصى لعدد الكلمات/التوكنز للرد الواحد (مثلاً 150 توكن)
PARAMETER num_predict 150

# التحكم بالعشوائية والتكرار
PARAMETER temperature 0.3
PARAMETER repeat_penalty 1.3
PARAMETER top_k 40
PARAMETER top_p 0.85

# نقاط التوقف
PARAMETER stop "<|endoftext|>"
PARAMETER stop "<|im_end|>"
PARAMETER stop "</html>"

